{
  "version": 2,
  "name": "agrinex",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/(.*).(jpg|jpeg|png|svg|ico|webp|woff|woff2|ttf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/farmer-module/?$",
      "dest": "/farmer-module/index.html"
    },
    {
      "src": "/buyer-module/?$",
      "dest": "/buyer-module/index.html"
    },
    {
      "src": "/admin-module/?$",
      "dest": "/admin-module/index.html"
    },
    {
      "src": "/logistics-module/?$",
      "dest": "/logistics-module/index.html"
    },
    {
      "src": "/login_details/?$",
      "dest": "/login_details/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
